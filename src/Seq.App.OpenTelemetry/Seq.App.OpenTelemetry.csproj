<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Seq.App.OpenTelemetry.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Seq.Apps" Version="2023.4.*" />
    <PackageReference Include="Google.Protobuf" Version="3.30.*" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.*" />
  </ItemGroup>

</Project>
